# Reference only: Spring Boot does not automatically load this file.
# Set these variables in the terminal before starting the application.
DB_URL=jdbc:postgresql://localhost:5432/stockguard
DB_USERNAME=your_database_role
DB_PASSWORD=your_local_password
# Base64 encoding of at least 32 cryptographically random bytes; never use this placeholder.
JWT_SECRET=generate_a_random_base64_signing_key

# Optional for the original local Spring profile; Compose enables Redis automatically.
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
